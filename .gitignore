# Local by Flywheel site runtime (not part of the WP codebase)
/conf/
/logs/
/.playwright-mcp/
/_quarantine_avangard_20260827/

# IDE
/.idea/
.vscode/

# Environment-specific WordPress config (DB creds, salts differ per environment)
/app/public/wp-config.php

# User-uploaded media — large binary content, not code; back up separately
/app/public/wp-content/uploads/

# WordPress cache / backup / upgrade artifacts
/app/public/wp-content/cache/
/app/public/wp-content/upgrade/
/app/public/wp-content/backup*/
/app/public/wp-content/*.sql
/app/public/wp-content/debug.log

# WebP Express generates a full mirrored cache of every upload — regenerable, not source content
/app/public/wp-content/webp-express/webp-images/
/app/public/wp-content/updraft/

# Full database dump — contains user data/password hashes, never belongs in git
/app/sql/

# OS cruft
.DS_Store

# Telegram chat export — contains plaintext passwords/hosting credentials
/messages.html
