u0439\u0442\u0438\u043d\u0433 \u0441\u0435\u0440\u0435\u0434 \u0443\u0441\u0456\u0445 \u0432\u0456\u0434\u0441\u0442\u0435\u0436\u0443\u0432\u0430\u043d\u0438\u0445 \u0431\u0440\u0435\u043d\u0434\u0456\u0432."],"Global AI Visibility Score":["\u0417\u0430\u0433\u0430\u043b\u044c\u043d\u0438\u0439 \u043f\u043e\u043a\u0430\u0437\u043d\u0438\u043a \u0432\u0438\u0434\u0438\u043c\u043e\u0441\u0442\u0456 \u0432 \u0428\u0406"],"Action failed. Please try again.":["\u0414\u0456\u044e \u043d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u0432\u0438\u043a\u043e\u043d\u0430\u0442\u0438. \u0421\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0449\u0435 \u0440\u0430\u0437."],"Something went wrong. Please try again.":["\u0429\u043e\u0441\u044c \u043f\u0456\u0448\u043b\u043e \u043d\u0435 \u0442\u0430\u043a. \u0411\u0443\u0434\u044c \u043b\u0430\u0441\u043a\u0430, \u0441\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0449\u0435 \u0440\u0430\u0437."],"Brand added! The first analysis is running \u2014 data will appear in approximately 10 minutes.":["\u0411\u0440\u0435\u043d\u0434 \u0434\u043e\u0434\u0430\u043d\u043e! \u041f\u0435\u0440\u0448\u0438\u0439 \u0430\u043d\u0430\u043b\u0456\u0437 \u0432\u0438\u043a\u043e\u043d\u0443\u0454\u0442\u044c\u0441\u044f - \u0434\u0430\u043d\u0456 \u0437\u2019\u044f\u0432\u043b\u044f\u0442\u044c\u0441\u044f \u043f\u0440\u0438\u0431\u043b\u0438\u0437\u043d\u043e \u0437\u0430 10 \u0445\u0432\u0438\u043b\u0438\u043d."],"Stop tracking \"%s\"? You can re-enable it later.":["\u041f\u0440\u0438\u043f\u0438\u043d\u0438\u0442\u0438 \u0432\u0456\u0434\u0441\u0442\u0435\u0436\u0435\u043d\u043d\u044f \"%s\"? \u0412\u0438 \u0437\u043c\u043e\u0436\u0435\u0442\u0435 \u0437\u043d\u043e\u0432\u0443 \u0443\u0432\u0456\u043c\u043a\u043d\u0443\u0442\u0438 \u0446\u0435 \u043f\u0456\u0437\u043d\u0456\u0448\u0435."],"Resume tracking \"%s\"? Analysis will run on the next scheduled cycle.":["\u0412\u0456\u0434\u043d\u043e\u0432\u0438\u0442\u0438 \u0432\u0456\u0434\u0441\u0442\u0435\u0436\u0435\u043d\u043d\u044f \"%s\"? \u0410\u043d\u0430\u043b\u0456\u0437 \u0431\u0443\u0434\u0435 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043e \u043f\u0456\u0434 \u0447\u0430\u0441 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u043e\u0433\u043e \u0437\u0430\u043f\u043b\u0430\u043d\u043e\u0432\u0430\u043d\u043e\u0433\u043e \u0446\u0438\u043a\u043b\u0443."],"Deactivate brand?":["\u0414\u0435\u0430\u043a\u0442\u0438\u0432\u0443\u0432\u0430\u0442\u0438 \u0431\u0440\u0435\u043d\u0434?"],"Activate brand?":["\u0410\u043a\u0442\u0438\u0432\u0443\u0432\u0430\u0442\u0438 \u0431\u0440\u0435\u043d\u0434?"],"\u2190 Back to Dashboard":["\u2190 \u041d\u0430\u0437\u0430\u0434 \u0434\u043e \u043c\u0430\u0439\u0441\u0442\u0435\u0440\u043d\u0456"],"Brand not found.":["\u0411\u0440\u0435\u043d\u0434 \u043d\u0435 \u0437\u043d\u0430\u0439\u0434\u0435\u043d\u043e."],"Failed to save brand.":["\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u0437\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u0431\u0440\u0435\u043d\u0434."],"Failed to load insights.":["\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0438\u0442\u0438 \u0430\u043d\u0430\u043b\u0456\u0442\u0438\u043a\u0443."],"Failed to load brand.":["\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0438\u0442\u0438 \u0431\u0440\u0435\u043d\u0434."],"Raw data \/ Transcripts":["\u041d\u0435\u043e\u0431\u0440\u043e\u0431\u043b\u0435\u043d\u0456 \u0434\u0430\u043d\u0456 \/ \u0420\u043e\u0437\u0448\u0438\u0444\u0440\u043e\u0432\u043a\u0438"],"Competitors":["\u041a\u043e\u043d\u043a\u0443\u0440\u0435\u043d\u0442\u0438"],"Queries":["\u0417\u0430\u043f\u0438\u0442\u0438"],"Transcripts will appear here once the first analysis completes.":["\u0420\u043e\u0437\u0448\u0438\u0444\u0440\u043e\u0432\u043a\u0438 \u0437\u2019\u044f\u0432\u043b\u044f\u0442\u044c\u0441\u044f \u0442\u0443\u0442 \u043f\u0456\u0441\u043b\u044f \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u044f \u043f\u0435\u0440\u0448\u043e\u0433\u043e \u0430\u043d\u0430\u043b\u0456\u0437\u0443."],"No transcripts found":["\u0420\u043e\u0437\u0448\u0438\u0444\u0440\u043e\u0432\u043e\u043a \u043d\u0435 \u0437\u043d\u0430\u0439\u0434\u0435\u043d\u043e"],"Competitor":["\u041a\u043e\u043d\u043a\u0443\u0440\u0435\u043d\u0442"],"Competitors are automatically identified during analysis runs.":["\u041a\u043e\u043d\u043a\u0443\u0440\u0435\u043d\u0442\u0438 \u0432\u0438\u0437\u043d\u0430\u0447\u0430\u044e\u0442\u044c\u0441\u044f \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e \u043f\u0456\u0434 \u0447\u0430\u0441 \u0437\u0430\u043f\u0443\u0441\u043a\u0456\u0432 \u0430\u043d\u0430\u043b\u0456\u0437\u0443."],"No competitors detected yet":["\u041a\u043e\u043d\u043a\u0443\u0440\u0435\u043d\u0442\u0456\u0432 \u0449\u0435 \u043d\u0435 \u0432\u0438\u044f\u0432\u043b\u0435\u043d\u043e"],"This will replace all existing baseline queries with new AI-generated ones. Continue?":["\u0426\u0435 \u0437\u0430\u043c\u0456\u043d\u0438\u0442\u044c \u0443\u0441\u0456 \u0456\u0441\u043d\u0443\u044e\u0447\u0456 \u0431\u0430\u0437\u043e\u0432\u0456 \u0437\u0430\u043f\u0438\u0442\u0438 \u043d\u043e\u0432\u0438\u043c\u0438, \u0437\u0433\u0435\u043d\u0435\u0440\u043e\u0432\u0430\u043d\u0438\u043c\u0438 \u0428\u0406. \u041f\u0440\u043e\u0434\u043e\u0432\u0436\u0438\u0442\u0438?"],"Regenerate queries?":["\u0417\u0433\u0435\u043d\u0435\u0440\u0443\u0432\u0430\u0442\u0438 \u0437\u0430\u043f\u0438\u0442\u0438 \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u043e?"],"Query text":["\u0422\u0435\u043a\u0441\u0442 \u0437\u0430\u043f\u0438\u0442\u0443"],"Regenerate baseline queries to start tracking how AI answers questions about this brand.":["\u041f\u043e\u0432\u0442\u043e\u0440\u043d\u043e \u0437\u0433\u0435\u043d\u0435\u0440\u0443\u0432\u0430\u0442\u0438 \u0431\u0430\u0437\u043e\u0432\u0456 \u0437\u0430\u043f\u0438\u0442\u0438, \u0449\u043e